{
  "expo": {
    "name": "My Life 1.0",
    "slug": "my-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adyl0022.mylife"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0f2c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adyl0022.mylife",
      "backgroundColor": "#0a0f2c"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "mylife",
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": "development"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "My Life uses your location to find your JAKIM prayer zone and the Qibla direction."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "backgroundColor": "#0a0f2c"
  }
}